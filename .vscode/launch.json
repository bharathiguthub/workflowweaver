{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FastAPI (uvicorn, mock planner)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--host", "127.0.0.1", "--port", "8000"],
      "cwd": "${workspaceFolder}/backend",
      "python": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "env": { "PLANNER_MODE": "mock" },
      "justMyCode": true
    },
    {
      "name": "Trace planning graph",
      "type": "debugpy",
      "request": "launch",
      "module": "scripts.trace_graph",
      "cwd": "${workspaceFolder}/backend",
      "python": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "justMyCode": true
    },
    {
      "name": "Pytest (current file)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}", "-v", "-p", "no:cacheprovider"],
      "cwd": "${workspaceFolder}/backend",
      "python": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "justMyCode": false
    }
  ]
}
