      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(ww_workflow_executions_finished_total{status=~\"failed|rolled_back|partially_rolled_back|compensation_failed|partially_completed\"}[$__range]))",
