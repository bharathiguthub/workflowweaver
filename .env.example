# Copy to .env (in this folder, the repo root) and fill in values locally. Never commit .env.
# Environment variables set in your shell take precedence over values in .env.

APP_ENV=development
LOG_LEVEL=INFO

# ---------- Phase 2: planner ----------
# mock   = deterministic keyword planner, no API key, no network (default)
# claude = Claude via the Anthropic Python SDK (structured outputs)
PLANNER_MODE=mock

# Required when PLANNER_MODE=claude. Read by the Anthropic SDK directly; never logged.
# Claude Code's own login does NOT provide this key - create one in the Claude Console.
ANTHROPIC_API_KEY=
# Required when PLANNER_MODE=claude. Model identifier, e.g. claude-opus-5
ANTHROPIC_MODEL=
ANTHROPIC_MAX_TOKENS=8000
PLANNER_TIMEOUT_SECONDS=60

# Safety limits
MAX_WORKFLOW_STEPS=10
MAX_PLANNING_ATTEMPTS=2

# ---------- Phase 3: mock execution ----------
# Execution uses in-memory mock tools only; no real Notion/Drive/Teams calls are made.
MOCK_EXECUTION_ENABLED=true
# Attempts per step (and per compensation) for transient errors, 1-5
EXECUTION_MAX_ATTEMPTS=3
EXECUTION_BACKOFF_BASE_SECONDS=0.2
EXECUTION_BACKOFF_MAX_SECONDS=2.0
EXECUTION_BACKOFF_JITTER=true

# ---------- Later phases (not read yet) ----------
# Notion MCP
NOTION_API_KEY=

# Google Drive MCP
GOOGLE_DRIVE_CREDENTIALS_PATH=

# Microsoft Teams
TEAMS_WEBHOOK_URL=

# Langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
