# Copy to .env (in this folder, the repo root) and fill in values locally. Never commit .env.
# Environment variables set in your shell take precedence over values in .env.

APP_ENV=development
LOG_LEVEL=INFO

# ---------- Phase 2: planner ----------
# mock   = deterministic keyword planner, no API key, no network (default)
# claude = Claude via the Anthropic Python SDK (structured outputs)
# gemini = Google Gemini via the official Google Gen AI SDK (google-genai, JSON schema output)
# auto   = PRIMARY_PLANNER (default groq) with automatic fallback to FALLBACK_PLANNER (default
#          gemini) ONLY when the primary is unavailable (HTTP 429, provider failure 500/502/503,
#          timeout 408/504, connection error)
#          after its bounded retries. Never for bad keys, refusals or invalid plans.
# The AI Project Plan workflow REQUIRES claude or gemini for real-mode plans; with mock it
# serves only mock/dry-run plans from a keyword stub labelled "Mock planner (not AI)".
PLANNER_MODE=mock

# Required when PLANNER_MODE=claude. Read from the shell or this file and passed to the
# Anthropic client; registered for log redaction; never logged or returned by the API.
# Claude Code's own login does NOT provide this key - create one in the Claude Console.
ANTHROPIC_API_KEY=
# Required when PLANNER_MODE=claude. Model identifier from your Claude Console, e.g. claude-opus-5-5
ANTHROPIC_MODEL=
ANTHROPIC_MAX_TOKENS=8000

# Required when PLANNER_MODE=gemini. Create the key in Google AI Studio. Read from the shell or
# this file, passed to the client explicitly, redacted from logs; never logged or returned.
GEMINI_API_KEY=
# Required when PLANNER_MODE=gemini. No default in code. gemini-3.8-flash was available to this
# project (models.list, 2026-11-04) and has a published free tier - but whether YOUR project
# is on the free tier depends on its billing setup: confirm in Google AI Studio first.
GEMINI_MODEL=
# Output limit per planning call; Gemini "thinking" tokens count toward it.
GEMINI_MAX_OUTPUT_TOKENS=16384

# PLANNER_MODE=auto: provider order. FALLBACK_PLANNER empty = no fallback. Values: gemini, groq, claude.
PRIMARY_PLANNER=groq
FALLBACK_PLANNER=gemini
# Groq (official groq SDK, strict json_schema structured outputs). Key from console.groq.com;
# shell or this file, redacted from logs, never logged or returned. If it is missing, auto
# mode still plans with the primary and /integrations/status reports the fallback as not configured.
GROQ_API_KEY=
# Must support STRICT structured outputs. Verified 2026-11-05 (console.groq.com/docs/models and
# /docs/structured-outputs): openai/gpt-oss-120b (production, strict). llama-3.3-70b-versatile was
# shut down on 2026-08-16 - do not use it.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MAX_TOKENS=8192
PLANNER_TIMEOUT_SECONDS=60

# Safety limits
MAX_WORKFLOW_STEPS=10
# Planner (LLM) attempts per plan for retryable errors (429, 5xx e.g. Gemini 503, timeouts,
# invalid output). Each attempt is one API call. Between attempts the planner waits with
# exponential backoff + jitter: ~0.5-1 s, then ~1-2 s, ... capped at the max.
MAX_PLANNING_ATTEMPTS=3
PLANNING_BACKOFF_BASE_SECONDS=1.0
PLANNING_BACKOFF_MAX_SECONDS=8.0
PLANNING_BACKOFF_JITTER=true

# ---------- Phase 3: mock execution ----------
# Execution uses in-memory mock tools only; no real Notion/Drive/Teams calls are made.
# false: /execute and /executions return 503, and planning skips the mock document check
MOCK_EXECUTION_ENABLED=true
# Attempts per step (and per compensation) for transient errors, 1-5
EXECUTION_MAX_ATTEMPTS=3
EXECUTION_BACKOFF_BASE_SECONDS=0.2
EXECUTION_BACKOFF_MAX_SECONDS=2.0
EXECUTION_BACKOFF_JITTER=true

# ---------- Phase 4: SSE live progress (in-memory, single process, mock-only) ----------
# Worker threads for POST /api/v1/workflows/executions (graph runs never block the event loop)
EXECUTION_WORKER_THREADS=4
SSE_HEARTBEAT_SECONDS=15
# How long a finished stream stays available for reconnects
SSE_RETENTION_SECONDS=300
SSE_MAX_CHANNELS=1000

# ---------- Phase 4: browser access (CORS) ----------
# Not needed with the default frontend setup (Vite dev proxy = same origin).
# Comma-separated EXACT origins; '*' is rejected. Empty: in APP_ENV=development the Vite dev
# origins http://localhost:5173 and http://127.0.0.1:5173 are allowed; otherwise none.
CORS_ALLOW_ORIGINS=

# ---------- Phase 4: Langfuse observability ----------
# Disabled by default. When enabled but keys are missing or the client cannot be created,
# telemetry silently falls back to a no-op; workflows are never affected.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
# Secret: set only here (local .env) or in your shell. Never logged, never sent to a browser.
LANGFUSE_SECRET_KEY=
# EU cloud: https://cloud.langfuse.com  US cloud: https://us.cloud.langfuse.com  or self-hosted URL.
# Leave empty for the SDK default.
LANGFUSE_BASE_URL=

# ---------- Phase 5.1: integration mode (server-controlled; clients can never change it) ----------
# mock    = in-memory adapters, synthetic data, no network (DEFAULT - keep this unless testing 5.x)
# dry_run = real adapters validate arguments, destinations and request shapes; NOTHING is sent
#           and no connection is opened. Needs destination aliases, not URLs/credentials.
# real    = real adapters call the MCP servers / webhooks below. Stage 5.1 has only been
#           tested against fakes; do not enable against production workspaces yet.
# approval.mode in every execution request must equal this value (else HTTP 409).
INTEGRATION_MODE=real

# Kill switch for side effects in real mode. false: plans with any write step are rejected
# before anything runs (read-only plans still run).
REAL_WRITES_ENABLED=false
# Operator credential for real writes. Callers send it as the X-Integration-Authorization
# header; it is compared in constant time and never logged. Empty = real writes impossible.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
REAL_WRITE_AUTHORIZATION_TOKEN=

# Timeouts for every MCP / webhook request
INTEGRATION_CONNECT_TIMEOUT_SECONDS=5
INTEGRATION_TIMEOUT_SECONDS=20

# ---------- Notion: self-hosted @notionhq/notion-mcp-server (Streamable HTTP) ----------
# Contract VERIFIED LIVE (Phase 5.2) against version 2.6.1: tools API-post-page / API-patch-page.
# Notion marks this server "no longer actively maintained"; pin the version you verified:
#   $env:NOTION_TOKEN = "<Notion internal integration token>"     # in the MCP SERVER's shell only
#   $env:AUTH_TOKEN   = "<random bearer token for this backend>"
#   npx @notionhq/notion-mcp-server@2.6.1 --transport http --port 3000   # binds 127.0.0.1
# Share each destination page / database with the Notion integration, or creation fails (404).
# https only, or http on a loopback address (e.g. http://127.0.0.1:3000/mcp).
NOTION_MCP_URL=http://127.0.0.1:3000/mcp
# The MCP server's AUTH_TOKEN (sent as a bearer token). Never the Notion integration token.
NOTION_MCP_AUTH_TOKEN=
# Subset of the verified tools. Tool names are fixed by the contract. Dropping API-patch-page
# makes created pages irreversible (no rollback); API-retrieve-a-page (read-only) is used by
# the smoke tests to read results back.
NOTION_MCP_TOOL_ALLOWLIST=API-retrieve-a-page
# Approved destinations: JSON alias -> Notion page / database id (UUID, dashed or 32-hex).
# Plans name aliases only (create_page "parent"); ids never leave the server. Example:
# NOTION_DESTINATIONS={"engineering": "00000000-0000-0000-0000-000000000000", "tasks": "11111111111111111111111111111111"}
NOTION_DESTINATIONS={"sandbox":"40e414832f0d80f3a0a3f6df599680d6"}
# Alias used when create_page has no "parent"
NOTION_DEFAULT_PAGE_PARENT=sandbox
# Alias of the database every create_task writes to (its title property must be "Name")
NOTION_TASK_DATABASE=

# ---------- Google Drive: official Google-hosted Drive MCP server ----------
# Contract DOCUMENTED ONLY (developers.google.com), not live-verified. Requires Google
# Workspace Developer Preview membership, the Drive API + Drive MCP API enabled, and an
# OAuth 2.0 client ("Use this client for an AI-powered agent").
# The server has NO delete/trash tool: created documents cannot be rolled back.
GOOGLE_DRIVE_MCP_URL=
# An OAuth 2.0 ACCESS token (scope drive.file for create, drive.readonly for reads). Access
# tokens expire (typically ~1 hour) and there is no refresh flow yet: Stage 5.2 blocker.
GOOGLE_DRIVE_MCP_AUTH_TOKEN=
# Remove create_file for read-only Drive access.
GOOGLE_DRIVE_MCP_TOOL_ALLOWLIST=create_file,search_files,read_file_content,get_file_metadata
# Approved folders: JSON alias -> folder id. Documents are created only here, and
# read_document only reads documents whose parentId is one of these folders.
# GOOGLE_DRIVE_DESTINATIONS={"reports": "<folder id>"}
GOOGLE_DRIVE_DESTINATIONS={}
GOOGLE_DRIVE_DEFAULT_FOLDER=

# ---------- Phase 6.1: Google Drive REST API v3 (OAuth 2.0, drive.file scope ONLY) ----------
# Full setup: docs/GOOGLE_DRIVE_SETUP.md. mcp (default) keeps the Phase 5 MCP adapter above;
# rest uses the Drive REST adapter: run folders, verified report uploads, listing and trash
# rollback. The OAuth scope is fixed in code to https://www.googleapis.com/auth/drive.file
# (the app sees ONLY files it creates) and cannot be changed by configuration.
GOOGLE_DRIVE_TRANSPORT=mcp
# OAuth client of type "Desktop app" (Google Cloud Console > APIs & Services > Credentials).
# Both are read from this file, passed to Google only, and redacted from logs and traces.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Where scripts/google_drive_auth.py stores the REFRESH token. Must be an absolute path OUTSIDE
# this repository (refused otherwise). Empty = %LOCALAPPDATA%\WorkflowWeaver\google-drive-token.json
# Access tokens are kept in memory only and never written to disk.
GOOGLE_DRIVE_TOKEN_FILE=
# true (default): Drive steps run ONLY in SMOKE_TEST_DRIVE_FOLDER or in folders created earlier
# in the same run. The sandbox folder must carry the private marker set by
# scripts/google_drive_sandbox.py create-folder, so a mistyped id of a real folder is refused.
GOOGLE_DRIVE_REAL_WRITES_SANDBOX_ONLY=true
# After create-folder, set e.g.:
# GOOGLE_DRIVE_DESTINATIONS={"sandbox": "<id printed by create-folder>"}
# SMOKE_TEST_DRIVE_FOLDER=sandbox

# ---------- Microsoft Teams: Workflows (Power Automate) incoming webhooks ----------
# Create one with the Teams "Workflows" app, template "Send webhook alerts to a channel",
# trigger authentication "Anyone" (tenant/user-restricted triggers need OAuth: not supported).
# Office 365 connector webhooks (*.webhook.office.com) were retired in May 2026 and are refused.
# Secret: JSON alias -> webhook URL (https only). The URL's sig= parameter is the credential;
# it is never logged, returned to clients, emitted over SSE or traced.
# TEAMS_WEBHOOK_URLS={"synthetic-team": "https://<...>.logic.azure.com:443/workflows/<...>&sig=<...>"}
TEAMS_WEBHOOK_URLS=
# Alias used when send_message has no "channel"
TEAMS_DEFAULT_CHANNEL=
# Phase 7.1 Teams Only workflow. true (default): in dry_run/real mode, messages go ONLY to
# SMOKE_TEST_TEAMS_CHANNEL (below). Real Teams Only plans require it to stay true.
# A sent message cannot be unsent or deleted by WorkflowWeaver (the webhook has no such API).
# Example sandbox setup (placeholders):
#   TEAMS_WEBHOOK_URLS={"sandbox": "https://<region>.logic.azure.com:443/workflows/<id>/triggers/manual/paths/invoke?api-version=2016-06-01&sp=<...>&sv=1.0&sig=<secret>"}
#   TEAMS_DEFAULT_CHANNEL=sandbox
#   SMOKE_TEST_TEAMS_CHANNEL=sandbox
TEAMS_REAL_WRITES_SANDBOX_ONLY=true

# ---------- Phase 5.3: controlled smoke tests (python -m scripts.smoke_integrations) ----------
# Aliases of NON-PRODUCTION sandbox destinations. Smoke-test writes go ONLY to these; each
# must also appear in the destination map above. Leave empty and smoke writes are impossible.
# See docs/INTEGRATION_SMOKE_TESTS.md for the full preflight checklist.
SMOKE_TEST_NOTION_PARENT=sandbox
# Phase 5.3 business workflow (AI Project Plan) and the UI Sandbox Test write ONLY under this
# alias. true (default): in dry_run/real mode, top-level Notion pages may be created only under
# SMOKE_TEST_NOTION_PARENT, child pages only inside pages created by the same run, and Notion
# task-database writes are refused. Set false only to allow other approved NOTION_DESTINATIONS.
NOTION_REAL_WRITES_SANDBOX_ONLY=true
SMOKE_TEST_DRIVE_FOLDER=
SMOKE_TEST_TEAMS_CHANNEL=
# Phase 7.2 Google Drive + Notion + Teams workflow: no new settings. It reads the source from
# SMOKE_TEST_DRIVE_FOLDER, creates pages under SMOKE_TEST_NOTION_PARENT and notifies
# SMOKE_TEST_TEAMS_CHANNEL; real mode also needs REAL_WRITES_ENABLED, REAL_WRITE_AUTHORIZATION_TOKEN,
# GOOGLE_DRIVE_TRANSPORT=rest (OAuth drive.file) and an AI planner (PLANNER_MODE=auto: Groq, Gemini fallback).
# Upload the source with: python -m scripts.google_drive_sandbox upload-source --confirm
