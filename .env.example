# Copy to .env (in this folder, the repo root) and fill in values locally. Never commit .env.
# Environment variables set in your shell take precedence over values in .env.

APP_ENV=development
LOG_LEVEL=INFO

# ---------- Phase 2: planner ----------
# mock   = deterministic keyword planner, no API key, no network (default)
# claude = Claude via the Anthropic Python SDK (structured outputs)
PLANNER_MODE=mock

# Required when PLANNER_MODE=claude. Read by the Anthropic SDK directly; never logged.
# Claude Code's own login does NOT provide this key - create one in the Claude Console.
ANTHROPIC_API_KEY=
# Required when PLANNER_MODE=claude. Model identifier, e.g. claude-opus-5
ANTHROPIC_MODEL=
ANTHROPIC_MAX_TOKENS=8000
PLANNER_TIMEOUT_SECONDS=60

# Safety limits
MAX_WORKFLOW_STEPS=10
MAX_PLANNING_ATTEMPTS=2

# ---------- Phase 3: mock execution ----------
# Execution uses in-memory mock tools only; no real Notion/Drive/Teams calls are made.
MOCK_EXECUTION_ENABLED=true
# Attempts per step (and per compensation) for transient errors, 1-5
EXECUTION_MAX_ATTEMPTS=3
EXECUTION_BACKOFF_BASE_SECONDS=0.2
EXECUTION_BACKOFF_MAX_SECONDS=2.0
EXECUTION_BACKOFF_JITTER=true

# ---------- Phase 4: SSE live progress (in-memory, single process, mock-only) ----------
# Worker threads for POST /api/v1/workflows/executions (graph runs never block the event loop)
EXECUTION_WORKER_THREADS=4
SSE_HEARTBEAT_SECONDS=15
# How long a finished stream stays available for reconnects
SSE_RETENTION_SECONDS=300
SSE_MAX_CHANNELS=1000

# ---------- Phase 4: browser access (CORS) ----------
# Not needed with the default frontend setup (Vite dev proxy = same origin).
# Comma-separated EXACT origins; '*' is rejected. Empty: in APP_ENV=development the Vite dev
# origins http://localhost:5173 and http://127.0.0.1:5173 are allowed; otherwise none.
CORS_ALLOW_ORIGINS=

# ---------- Phase 4: Langfuse observability ----------
# Disabled by default. When enabled but keys are missing or the client cannot be created,
# telemetry silently falls back to a no-op; workflows are never affected.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
# Secret: set only here (local .env) or in your shell. Never logged, never sent to a browser.
LANGFUSE_SECRET_KEY=
# EU cloud: https://cloud.langfuse.com  US cloud: https://us.cloud.langfuse.com  or self-hosted URL.
# Leave empty for the SDK default.
LANGFUSE_BASE_URL=

# ---------- Later phases (not read yet) ----------
# Notion MCP
NOTION_API_KEY=

# Google Drive MCP
GOOGLE_DRIVE_CREDENTIALS_PATH=

# Microsoft Teams
TEAMS_WEBHOOK_URL=

