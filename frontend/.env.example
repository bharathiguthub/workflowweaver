# Frontend settings. Copy to .env.local (git-ignored) if you need to change them.
# Everything prefixed VITE_ is compiled into the browser bundle and is PUBLIC.
# Never put API keys (Anthropic, Langfuse, ...) in any frontend .env file.

# Empty (default): call the API on the same origin; the Vite dev server proxies /api and
# /health to the backend. Set an absolute URL (e.g. http://127.0.0.1:8000) only if you
# serve the built app elsewhere; the backend must then allow that origin
# (CORS_ALLOW_ORIGINS in the repo-root .env).
VITE_API_BASE_URL=

# Dev-server proxy target (read by vite.config.ts only, never sent to the browser).
WW_BACKEND_URL=http://127.0.0.1:8000
